# ─── Entorno: LOCAL ──────────────────────────────────────────────────────────
# Usado por las configuraciones "– Local" en launch.json y tasks.json.
# Copia este archivo como .env para uso directo desde terminal.

# URL base de la aplicación
BASE_URL=https://www.saucedemo.com

# Usuarios de prueba
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user

# Contraseña en Base64  (secret_sauce → c2VjcmV0X3NhdWNl)
PASSWORD=c2VjcmV0X3NhdWNl

# Configuración del navegador: chromium | firefox | webkit
BROWSER=chromium
HEADLESS=true
